{
  "name": "dsh-startup-hub",
  "version": "1.1.0",
  "type": "module",
  "description": "启动动画中心：发现并切换本机的启动动画版本，每个版本还能单独调播放、身份、交互、语音、视觉与文案；点一下立即应用，不需要重启 DSH。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "startup",
    "splash",
    "boot-animation"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "defaults.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
